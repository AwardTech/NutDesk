<ContextMenu x:Class="NutDesk.Wpf.AppMenu"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ItemsSource="{Binding Items}"
             Focusable="True"
             StaysOpen="False"
             MinWidth="220"
             FontFamily="Segoe UI Variable Text, Segoe UI"
             FontSize="13"
             Foreground="{DynamicResource TextPrimaryBrush}"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True">

    <ContextMenu.Resources>

        <!-- One style for every level. Each MenuItem generates its own submenu items, and a MenuItem does not
             pass its ItemContainerStyle on, so the style names itself as the style of its children - through
             DynamicResource, which is the only way a style can refer to itself. -->
        <Style x:Key="AppMenuItem" TargetType="MenuItem">
            <Setter Property="Header" Value="{Binding Header}" />
            <Setter Property="Command" Value="{Binding Command}" />
            <Setter Property="IsEnabled" Value="{Binding IsEnabled}" />
            <!-- One-way on purpose, and IsCheckable stays false: the WinForms item toggles itself when clicked,
                 and a second toggle here would fight it until the next refresh. -->
            <Setter Property="IsChecked" Value="{Binding IsChecked, Mode=OneWay}" />
            <Setter Property="ItemsSource" Value="{Binding Children}" />
            <Setter Property="ItemContainerStyle" Value="{DynamicResource AppMenuItem}" />
            <Setter Property="ToolTip" Value="{Binding ToolTip}" />
            <!-- The old-preferences entry uses its tooltip to say why it is greyed out, so it has to show then. -->
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Padding" Value="4,7,10,7" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Grid SnapsToDevicePixels="True">
                            <Border x:Name="Chrome" CornerRadius="5" Background="Transparent"
                                    Padding="{TemplateBinding Padding}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="26" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- The gutter is always reserved, so captions line up whether or not
                                         their neighbours can carry a check mark. -->
                                    <TextBlock x:Name="Check" Grid.Column="0" Text="&#xE73E;"
                                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Foreground="{DynamicResource AccentBrush}" Visibility="Hidden" />

                                    <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True"
                                                      VerticalAlignment="Center" />

                                    <TextBlock x:Name="Arrow" Grid.Column="2" Text="&#xE76C;" Margin="16,0,0,0"
                                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                </Grid>
                            </Border>

                            <!-- The submenu. The offsets cancel the shadow gutter and the parent's padding, so
                                 the first child sits level with this item and just overlaps the parent's edge. -->
                            <Popup x:Name="PART_Popup" Placement="Right" HorizontalOffset="-5" VerticalOffset="-13"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Fade"
                                   IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}">
                                <Border Margin="8" Padding="4" CornerRadius="8" BorderThickness="1" MinWidth="200"
                                        Background="{DynamicResource CardBrush}"
                                        BorderBrush="{DynamicResource CardBorderBrush}">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="14" ShadowDepth="2" Direction="270"
                                                          Opacity="{DynamicResource ShadowOpacity}" Color="#000000" />
                                    </Border.Effect>
                                    <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                                </Border>
                            </Popup>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="Arrow" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <!-- IsHighlighted rather than IsMouseOver: it is also what the arrow keys move, and
                                 it stays on a header while its submenu is open. -->
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource PressedBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

            <Style.Triggers>
                <!-- A separator arrives as an item like any other, so it is a MenuItem restyled as a hairline.
                     Disabled and unfocusable, the arrow keys step over it. -->
                <DataTrigger Binding="{Binding IsSeparator}" Value="True">
                    <Setter Property="IsEnabled" Value="False" />
                    <Setter Property="Focusable" Value="False" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="MenuItem">
                                <Border Height="1" Margin="10,4" SnapsToDevicePixels="True"
                                        Background="{DynamicResource CardBorderBrush}" />
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
            </Style.Triggers>
        </Style>

    </ContextMenu.Resources>

    <ContextMenu.ItemContainerStyle>
        <StaticResource ResourceKey="AppMenuItem" />
    </ContextMenu.ItemContainerStyle>

    <!-- Rounded card chrome instead of the system menu frame. The transparent margin leaves room for the
         shadow inside the popup window, which would otherwise clip it; AppMenu.Open takes it back out when
         placing the menu, so the card itself is what lines up with the button. -->
    <ContextMenu.Template>
        <ControlTemplate TargetType="ContextMenu">
            <Border Margin="8" Padding="4" CornerRadius="8" BorderThickness="1"
                    Background="{DynamicResource CardBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="14" ShadowDepth="2" Direction="270"
                                      Opacity="{DynamicResource ShadowOpacity}" Color="#000000" />
                </Border.Effect>
                <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
            </Border>
        </ControlTemplate>
    </ContextMenu.Template>
</ContextMenu>
