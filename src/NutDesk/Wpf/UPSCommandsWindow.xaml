<Window x:Class="NutDesk.Wpf.UPSCommandsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="620" Height="650" MinWidth="500" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Title="UPS Commands"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        Background="{DynamicResource WindowBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        UseLayoutRounding="True">
    <Window.Resources>
        <Style x:Key="CommandButton" TargetType="Button">
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="MinWidth" Value="150" />
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="22">
            <TextBlock Text="UPS Commands" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Text="Commands advertised by the connected NUT server" Margin="0,4,0,14"
                       Foreground="{DynamicResource TextSecondaryBrush}" />
            <DockPanel Margin="0,0,0,14">
                <Button x:Name="RefreshButton" DockPanel.Dock="Right" Content="Refresh command list"
                        Padding="12,6" Click="RefreshButton_Click" />
                <TextBlock x:Name="StatusText" VerticalAlignment="Center" Text="Command list has not been loaded."
                           TextWrapping="Wrap" Margin="0,0,12,0" />
            </DockPanel>

            <Border Padding="14" Margin="0,0,0,12" CornerRadius="8"
                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                    Background="{DynamicResource CardBrush}">
                <StackPanel>
                    <TextBlock Text="Battery tests" Style="{StaticResource SectionTitle}" />
                    <WrapPanel>
                        <Button Content="Start quick battery test" IsEnabled="False" Style="{StaticResource CommandButton}" />
                        <Button Content="Start deep battery test" IsEnabled="False" Style="{StaticResource CommandButton}" />
                        <Button Content="Stop battery test" IsEnabled="False" Style="{StaticResource CommandButton}" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border Padding="14" Margin="0,0,0,12" CornerRadius="8"
                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                    Background="{DynamicResource CardBrush}">
                <StackPanel>
                    <TextBlock Text="Beeper controls" Style="{StaticResource SectionTitle}" />
                    <WrapPanel>
                        <Button Content="Beeper on" IsEnabled="False" Style="{StaticResource CommandButton}" />
                        <Button Content="Beeper off" IsEnabled="False" Style="{StaticResource CommandButton}" />
                        <Button Content="Mute beeper" IsEnabled="False" Style="{StaticResource CommandButton}" />
                        <Button Content="Enable beeper" IsEnabled="False" Style="{StaticResource CommandButton}" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border Padding="14" Margin="0,0,0,12" CornerRadius="8"
                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                    Background="{DynamicResource CardBrush}">
                <StackPanel>
                    <TextBlock Text="Power controls" Style="{StaticResource SectionTitle}" />
                    <WrapPanel>
                        <Button Content="load.off" IsEnabled="False" ToolTip="Not yet implemented" Style="{StaticResource CommandButton}" />
                        <Button Content="load.off.delay" IsEnabled="False" ToolTip="Not yet implemented" Style="{StaticResource CommandButton}" />
                        <Button Content="shutdown.reboot" IsEnabled="False" ToolTip="Not yet implemented" Style="{StaticResource CommandButton}" />
                        <Button Content="shutdown.stop" IsEnabled="False" ToolTip="Not yet implemented" Style="{StaticResource CommandButton}" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border Padding="14" CornerRadius="8" BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1" Background="{DynamicResource CardBrush}">
                <StackPanel>
                    <TextBlock Text="Commands reported by the server" Style="{StaticResource SectionTitle}" />
                    <ListBox x:Name="CommandList" MinHeight="90" MaxHeight="180"
                             Background="Transparent" BorderThickness="0" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Window>
