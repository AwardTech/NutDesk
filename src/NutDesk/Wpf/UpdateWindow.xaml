<Window x:Class="NutDesk.Wpf.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="720" Height="600" MinWidth="660" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        FontSize="13"
        Background="{DynamicResource WindowBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style TargetType="ToolTip">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="{DynamicResource CardBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="4" Padding="9,6" MaxWidth="380">
                            <ContentPresenter>
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextWrapping" Value="Wrap" />
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The preferences window's card: rounded, hairline border, a little shadow. -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="14" ShadowDepth="1.5" Direction="270"
                                      Opacity="{DynamicResource ShadowOpacity}" Color="#000000" />
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CardHeading" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="CommandButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource CardBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="16,7" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="MinWidth" Value="96" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource PressedBrush}" />
                            </Trigger>
                            <!-- The keyboard user has to see where Enter and Space will land. -->
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource CommandButton}">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.75" />
                            </Trigger>
                            <!-- The accent fill does not change with focus, so the ring goes around it. -->
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource TextPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A thin rounded meter in the palette. The stock bar is drawn by the system theme, which ignores the dark
             palette; its indeterminate animation lives in that theme too, so this one brings its own sweep. -->
        <Style x:Key="Meter" TargetType="ProgressBar">
            <Setter Property="Height" Value="6" />
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="100" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid ClipToBounds="True" SnapsToDevicePixels="True">
                            <Border x:Name="PART_Track" CornerRadius="3" Background="{DynamicResource TrackBrush}" />
                            <Border x:Name="PART_Indicator" CornerRadius="3" HorizontalAlignment="Left"
                                    Background="{DynamicResource AccentBrush}" />
                            <Border x:Name="Sweep" Width="96" CornerRadius="3" HorizontalAlignment="Left"
                                    Background="{DynamicResource AccentBrush}" Visibility="Collapsed">
                                <Border.RenderTransform>
                                    <TranslateTransform X="-96" />
                                </Border.RenderTransform>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsIndeterminate" Value="True">
                                <Setter TargetName="PART_Indicator" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="Sweep" Property="Visibility" Value="Visible" />
                                <Trigger.EnterActions>
                                    <BeginStoryboard x:Name="SweepMotion">
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation Storyboard.TargetName="Sweep"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                             From="-96" To="1000" Duration="0:0:1.8" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <StopStoryboard BeginStoryboardName="SweepMotion" />
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header: which version, against which one. -->
        <Grid Grid.Row="0" Margin="24,22,24,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Width="44" Height="44" CornerRadius="22" VerticalAlignment="Top"
                    Background="{DynamicResource AccentBrush}">
                <Path Width="20" Height="20" Stretch="Uniform"
                      Data="M13.5,8 A5.5,5.5 0 1 1 11.9,4.1 M12.5,1.5 V4.5 H9.5"
                      Stroke="{DynamicResource AccentTextBrush}" StrokeThickness="1.8"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
            </Border>

            <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                <WrapPanel>
                    <TextBlock Margin="0,0,10,0" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"
                               Text="{Binding Heading}" />
                    <Border Margin="0,2,0,0" Padding="8,1" CornerRadius="10" BorderThickness="1" VerticalAlignment="Center"
                            BorderBrush="{DynamicResource WarningBrush}"
                            Visibility="{Binding IsPreRelease, Converter={StaticResource BoolToVis}}">
                        <TextBlock FontSize="11" Foreground="{DynamicResource WarningBrush}" Text="{Binding PreReleaseCaption}" />
                    </Border>
                </WrapPanel>
                <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"
                           Text="{Binding Subheading}" />
            </StackPanel>
        </Grid>

        <!-- Release notes. The scroller takes the keyboard focus, so the notes can be read with the arrow keys. -->
        <Border Grid.Row="1" Margin="24,0,24,14" Style="{StaticResource Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Margin="18,12,18,8" Style="{StaticResource CardHeading}" Text="{Binding NotesHeading}" />

                <ScrollViewer x:Name="NotesScroller" Grid.Row="1" Padding="18,0,18,14" Focusable="True"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              AutomationProperties.Name="{Binding NotesHeading}">
                    <Grid>
                        <ItemsControl Focusable="False" IsTabStop="False" ItemsSource="{Binding Notes}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="{Binding Margin}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock MinWidth="14" Margin="0,0,6,0" Text="{Binding Marker}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   Visibility="{Binding HasMarker, Converter={StaticResource BoolToVis}}" />
                                        <TextBlock Grid.Column="1" TextWrapping="Wrap" Text="{Binding Text}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsHeading}" Value="True">
                                                            <Setter Property="FontSize" Value="15" />
                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsMinorHeading}" Value="True">
                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsCode}" Value="True">
                                                            <Setter Property="FontFamily" Value="Consolas, Courier New" />
                                                            <Setter Property="FontSize" Value="12" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"
                                   Visibility="{Binding HasNoNotes, Converter={StaticResource BoolToVis}}"
                                   Text="{Binding NoNotesText}" />
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Status: the step under way and its progress, the verdict, or what to do next. -->
        <Border Grid.Row="2" Margin="24,0,24,16" Padding="18,12" Style="{StaticResource Card}"
                Visibility="{Binding HasStatus, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <TextBlock x:Name="StatusLine" TextWrapping="Wrap" FontWeight="SemiBold" Text="{Binding StatusText}"
                           AutomationProperties.LiveSetting="Polite">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding StatusTone}" Value="Success">
                                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding StatusTone}" Value="Warning">
                                    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding StatusTone}" Value="Error">
                                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding StatusText}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- A read-only box rather than a text block: the manual update names folders, and the user may want to
                     copy them. Drawn as plain text; the negative margin takes back the gap a text box keeps around its
                     text, so the lines align with the status line above. -->
                <TextBox Margin="-2,6,-2,0" Padding="0" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0"
                         Background="Transparent" Foreground="{DynamicResource TextSecondaryBrush}"
                         CaretBrush="{DynamicResource TextSecondaryBrush}" SelectionBrush="{DynamicResource AccentBrush}"
                         Visibility="{Binding HasNote, Converter={StaticResource BoolToVis}}"
                         Text="{Binding NoteText, Mode=OneWay}">
                    <TextBox.Template>
                        <ControlTemplate TargetType="TextBox">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                          HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled" />
                        </ControlTemplate>
                    </TextBox.Template>
                </TextBox>

                <Grid Margin="0,10,0,0" Visibility="{Binding ShowProgress, Converter={StaticResource BoolToVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ProgressBar Style="{StaticResource Meter}" VerticalAlignment="Center"
                                 Value="{Binding ProgressValue, Mode=OneWay}"
                                 IsIndeterminate="{Binding IsProgressIndeterminate, Mode=OneWay}"
                                 AutomationProperties.Name="{Binding StatusText}" />
                    <TextBlock Grid.Column="1" MinWidth="120" Margin="12,0,0,0" TextAlignment="Right" FontSize="12"
                               VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="{Binding ProgressText}" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- Footer: the two ways out of this release on the left, the action and Close on the right. -->
        <Border Grid.Row="3" BorderThickness="0,1,0,0"
                Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource CardBorderBrush}">
            <Grid Margin="16,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button Style="{StaticResource CommandButton}" Margin="0"
                            Content="{Binding SkipCaption}" ToolTip="{Binding SkipTip}"
                            Command="{Binding SkipCommand}" />
                    <Button Style="{StaticResource CommandButton}"
                            Content="{Binding ReleasePageCaption}" ToolTip="{Binding ReleasePageTip}"
                            Command="{Binding ReleasePageCommand}" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button x:Name="PrimaryButton" Style="{StaticResource AccentButton}" Margin="0"
                            Content="{Binding PrimaryCaption}" ToolTip="{Binding PrimaryTip}"
                            Command="{Binding PrimaryCommand}"
                            Visibility="{Binding ShowPrimary, Converter={StaticResource BoolToVis}}" />
                    <Button x:Name="CancelButton" Style="{StaticResource CommandButton}" Margin="0"
                            Content="{Binding CancelCaption}" Command="{Binding CancelCommand}"
                            Visibility="{Binding ShowCancel, Converter={StaticResource BoolToVis}}" />
                    <Button x:Name="CloseButton" Style="{StaticResource CommandButton}"
                            Content="{Binding CloseCaption}" Command="{Binding CloseCommand}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
