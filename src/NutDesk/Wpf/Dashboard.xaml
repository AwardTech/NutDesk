<UserControl x:Class="NutDesk.Wpf.Dashboard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:NutDesk.Wpf"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             FontFamily="Segoe UI Variable Text, Segoe UI"
             FontSize="13"
             Background="{DynamicResource WindowBrush}"
             Foreground="{DynamicResource TextPrimaryBrush}">

    <UserControl.Resources>

        <!-- A card: rounded, hairline border, and just enough shadow to lift it off the surface. -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16,13,16,13" />
            <Setter Property="Margin" Value="6" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="14" ShadowDepth="1.5" Direction="270"
                                      Opacity="{DynamicResource ShadowOpacity}" Color="#000000" />
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CardCaption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="FieldCaption" TargetType="TextBlock" BasedOn="{StaticResource CardCaption}">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="0,0,0,1" />
        </Style>

        <Style x:Key="FieldValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>

        <!-- Fluent-ish command button: quiet by default, subtle wash on hover. -->
        <Style x:Key="CommandButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource CardBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="16,7" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="MinWidth" Value="96" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background"
                                        Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background"
                                        Value="{DynamicResource PressedBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource CommandButton}">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.75" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A state lamp: a dot that is only coloured while its condition holds. -->
        <Style x:Key="Lamp" TargetType="Ellipse">
            <Setter Property="Width" Value="10" />
            <Setter Property="Height" Value="10" />
            <Setter Property="Margin" Value="0,0,9,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Fill" Value="{DynamicResource NeutralBrush}" />
        </Style>

    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ================= Header ================= -->
        <Border Grid.Row="0" Padding="20,12,14,12" Background="{DynamicResource WindowBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding AppTitle}" FontSize="19" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="{Binding ServerText}" FontSize="11" Margin="1,1,0,0"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>

                <!-- Status chip -->
                <Border Grid.Column="1" x:Name="StatusChip" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Background="{DynamicResource CardBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                        CornerRadius="14" Padding="12,5,14,5" Margin="0,0,14,0">
                    <!-- A DockPanel, not a StackPanel: a horizontal StackPanel measures its children with
                         infinite width, so the TextBlock would never be arranged narrower than its text and
                         the ellipsis below could never trigger - the chip would just overflow its column.
                         Trimming matters here because the reconnection wording is the longest string the UI
                         can show and the chip lives in the star column that gives way first. -->
                    <DockPanel MaxWidth="260">
                        <Ellipse x:Name="StatusDot" Width="9" Height="9" VerticalAlignment="Center"
                                 DockPanel.Dock="Left" Margin="0,0,8,0" Fill="{DynamicResource NeutralBrush}" />
                        <TextBlock Text="{Binding ConnectionText}" VerticalAlignment="Center" FontSize="12"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                    </DockPanel>
                </Border>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="{Binding CaptionConnect}" Command="{Binding ConnectCommand}"
                            Style="{StaticResource AccentButton}">
                        <Button.Visibility>
                            <Binding Path="ShowConnect" Converter="{x:Static local:Dashboard.BoolVisibility}" />
                        </Button.Visibility>
                    </Button>
                    <Button Content="{Binding CaptionDisconnect}" Command="{Binding DisconnectCommand}"
                            Style="{StaticResource CommandButton}">
                        <Button.Visibility>
                            <Binding Path="CanDisconnect" Converter="{x:Static local:Dashboard.BoolVisibility}" />
                        </Button.Visibility>
                    </Button>
                    <Button Content="{Binding CaptionSettings}" Command="{Binding SettingsCommand}"
                            Style="{StaticResource CommandButton}" />
                    <!-- A click handler rather than a command: the menu is anchored to this button, and only
                         the view knows where the button is. -->
                    <Button x:Name="OverflowButton" Content="&#xE712;" Click="OnOverflowClick"
                            Style="{StaticResource CommandButton}" MinWidth="40" Padding="0"
                            FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14"
                            AutomationProperties.Name="{Binding CaptionMoreOptions}"
                            ToolTip="{Binding CaptionMoreOptions}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= Cards ================= -->
        <Grid Grid.Row="1" Margin="14,2,14,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="31*" />
                <ColumnDefinition Width="23*" />
                <ColumnDefinition Width="23*" />
                <ColumnDefinition Width="23*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Hero: battery -->
            <Border Grid.Column="0" Grid.RowSpan="2" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="{Binding CaptionBatteryCharge}"
                               Style="{StaticResource CardCaption}" />

                    <local:RingGauge Grid.Row="1" x:Name="BatteryGauge" Margin="0,6,0,6"
                                     Emphasis="1.25"
                                     Value="{Binding BatteryCharge}"
                                     DisplayText="{Binding BatteryChargeText}"
                                     Minimum="0" Maximum="100" />

                    <StackPanel Grid.Row="2" Margin="0,2,0,10">
                        <TextBlock Text="{Binding CaptionRuntime}" Style="{StaticResource FieldCaption}" />
                        <!-- This slot gets the whole "variable unavailable" sentence when the runtime cannot
                             be read, which at this size is far wider than the duration it usually holds. -->
                        <TextBlock Text="{Binding RuntimeText}" FontSize="24" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                    </StackPanel>

                    <StackPanel Grid.Row="3">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,7">
                            <Ellipse x:Name="LampOnLine" Style="{StaticResource Lamp}" />
                            <TextBlock Text="{Binding CaptionOnLine}" VerticalAlignment="Center" FontSize="12" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,7">
                            <Ellipse x:Name="LampOnBattery" Style="{StaticResource Lamp}" />
                            <TextBlock Text="{Binding CaptionOnBattery}" VerticalAlignment="Center" FontSize="12" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,7">
                            <Ellipse x:Name="LampOverload" Style="{StaticResource Lamp}" />
                            <TextBlock Text="{Binding CaptionOverload}" VerticalAlignment="Center" FontSize="12" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="LampBatteryLow" Style="{StaticResource Lamp}" />
                            <TextBlock Text="{Binding CaptionBatteryLow}" VerticalAlignment="Center" FontSize="12" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Load -->
            <Border Grid.Column="1" Grid.Row="0" Style="{StaticResource Card}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{Binding CaptionLoad}"
                               Style="{StaticResource CardCaption}" />
                    <local:RingGauge x:Name="LoadGauge" Margin="0,6,0,0"
                                     Value="{Binding LoadPercent}"
                                     DisplayText="{Binding LoadText}"
                                     SecondaryText="{Binding PowerText}"
                                     Minimum="0" Maximum="100" />
                </DockPanel>
            </Border>

            <!-- Input voltage -->
            <Border Grid.Column="2" Grid.Row="0" Style="{StaticResource Card}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{Binding CaptionInputVoltage}"
                               Style="{StaticResource CardCaption}" />
                    <local:RingGauge x:Name="InputGauge" Margin="0,6,0,0"
                                     Value="{Binding InputVoltage}"
                                     DisplayText="{Binding InputVoltageText}"
                                     Minimum="{Binding InputVoltageMin}" Maximum="{Binding InputVoltageMax}" />
                </DockPanel>
            </Border>

            <!-- Output voltage -->
            <Border Grid.Column="3" Grid.Row="0" Style="{StaticResource Card}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{Binding CaptionOutputVoltage}"
                               Style="{StaticResource CardCaption}" />
                    <local:RingGauge x:Name="OutputGauge" Margin="0,6,0,0"
                                     Value="{Binding OutputVoltage}"
                                     DisplayText="{Binding OutputVoltageText}"
                                     Minimum="{Binding OutputVoltageMin}" Maximum="{Binding OutputVoltageMax}" />
                </DockPanel>
            </Border>

            <!-- Battery voltage -->
            <Border Grid.Column="1" Grid.Row="1" Style="{StaticResource Card}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{Binding CaptionBatteryVoltage}"
                               Style="{StaticResource CardCaption}" />
                    <local:RingGauge x:Name="BatteryVoltageGauge" Margin="0,6,0,0"
                                     Value="{Binding BatteryVoltage}"
                                     DisplayText="{Binding BatteryVoltageText}"
                                     Minimum="{Binding BatteryVoltageMin}" Maximum="{Binding BatteryVoltageMax}" />
                </DockPanel>
            </Border>

            <!-- Frequency -->
            <Border Grid.Column="2" Grid.Row="1" Style="{StaticResource Card}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{Binding CaptionFrequency}"
                               Style="{StaticResource CardCaption}" />
                    <local:RingGauge x:Name="FrequencyGauge" Margin="0,6,0,0"
                                     Value="{Binding Frequency}"
                                     DisplayText="{Binding FrequencyText}"
                                     Minimum="{Binding FrequencyMin}" Maximum="{Binding FrequencyMax}" />
                </DockPanel>
            </Border>

            <!-- Device -->
            <Border Grid.Column="3" Grid.Row="1" Style="{StaticResource Card}">
                <StackPanel>
                    <!-- The heading is the localized caption, not the UPS name: the name is empty until one is
                         configured, which left this card as the only unlabelled one on the board. -->
                    <TextBlock Text="{Binding CaptionDevice}" Style="{StaticResource CardCaption}" />
                    <TextBlock Text="{Binding UpsNameText}" Style="{StaticResource FieldValue}" />
                    <TextBlock Text="{Binding CaptionManufacturer}" Style="{StaticResource FieldCaption}" />
                    <TextBlock Text="{Binding Manufacturer}" Style="{StaticResource FieldValue}" />
                    <TextBlock Text="{Binding CaptionModel}" Style="{StaticResource FieldCaption}" />
                    <TextBlock Text="{Binding Model}" Style="{StaticResource FieldValue}" />
                    <TextBlock Text="{Binding CaptionSerial}" Style="{StaticResource FieldCaption}" />
                    <TextBlock Text="{Binding Serial}" Style="{StaticResource FieldValue}" />
                    <TextBlock Text="{Binding CaptionFirmware}" Style="{StaticResource FieldCaption}" />
                    <TextBlock Text="{Binding Firmware}" Style="{StaticResource FieldValue}" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- ================= Status bar ================= -->
        <Border Grid.Row="2" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,1,0,0"
                Background="{DynamicResource WindowBrush}" Padding="20,7,20,7">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{Binding LatestLogLine}" FontSize="12"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}" />

                <TextBlock Grid.Column="1" Text="{Binding UpsNameText}" FontSize="11" Margin="14,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
