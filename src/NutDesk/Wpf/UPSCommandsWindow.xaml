<Window x:Class="NutDesk.Wpf.UPSCommandsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="620" Height="650" MinWidth="500" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Title="UPS Commands"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        Background="{DynamicResource WindowBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        UseLayoutRounding="True">
    <Window.Resources>
        <Style x:Key="CommandButton" TargetType="Button">
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="MinWidth" Value="150" />
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="22">
            <TextBlock Text="UPS Commands" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Text="Commands advertised by the connected NUT server" Margin="0,4,0,14"
                       Foreground="{DynamicResource TextSecondaryBrush}" />
            <TextBlock Text="Note: Instant commands may require NUT login credentials. If a command fails with an authentication error, enter your username and password in Settings → Connection, then try again."
                       TextWrapping="Wrap" Margin="0,-8,0,14"
                       Foreground="{DynamicResource TextSecondaryBrush}" />
            <DockPanel Margin="0,0,0,14">
                <Button x:Name="RefreshButton" DockPanel.Dock="Right" Content="Refresh command list"
                        Padding="12,6" Click="RefreshButton_Click" />
                <TextBlock x:Name="StatusText" VerticalAlignment="Center" Text="Command list has not been loaded."
                           TextWrapping="Wrap" Margin="0,0,12,0" />
            </DockPanel>

            <Border Padding="14" Margin="0,0,0,12" CornerRadius="8"
                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                    Background="{DynamicResource CardBrush}">
                <StackPanel>
                    <TextBlock Text="Battery tests" Style="{StaticResource SectionTitle}" />
                    <WrapPanel>
                        <Button x:Name="QuickTestButton" Content="Start quick battery test" Tag="test.battery.start.quick"
                                IsEnabled="False" Click="InstantCommand_Click" Style="{StaticResource CommandButton}" />
                        <Button x:Name="DeepTestButton" Content="Start deep battery test" Tag="test.battery.start.deep"
                                IsEnabled="False" Click="InstantCommand_Click" Style="{StaticResource CommandButton}" />
                        <Button x:Name="StopTestButton" Content="Stop battery test" Tag="test.battery.stop"
                                IsEnabled="False" Click="InstantCommand_Click" Style="{StaticResource CommandButton}" />
                    </WrapPanel>
                    <Border Margin="0,2,0,10" Padding="10,8" CornerRadius="6"
                            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                            Background="{DynamicResource WindowBrush}">
                        <StackPanel>
                            <TextBlock Text="Battery Test Status" FontWeight="SemiBold" Margin="0,0,0,3" />
                            <TextBlock x:Name="BatteryTestStatusText" Text="Checking UPS test status..."
                                       TextWrapping="Wrap" />
                            <TextBlock x:Name="BatteryTestRawResultText" Text="NUT result: —"
                                       FontSize="11" Margin="0,3,0,0"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                    </Border>
                    <TextBlock Text="Command feedback" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <TextBlock x:Name="BatteryCommandFeedbackText" Text="No battery-test command sent in this session."
                               TextWrapping="Wrap" Margin="0,0,0,2" />
                </StackPanel>
            </Border>

            <Border Padding="14" Margin="0,0,0,12" CornerRadius="8"
                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                    Background="{DynamicResource CardBrush}">
                <StackPanel>
                    <TextBlock Text="Beeper controls" Style="{StaticResource SectionTitle}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Button x:Name="BeeperOnButton" Grid.Row="0" Grid.Column="0" Content="Beeper on" Tag="beeper.on"
                                IsEnabled="False" Click="InstantCommand_Click" Style="{StaticResource CommandButton}" />
                        <Button x:Name="BeeperOffButton" Grid.Row="0" Grid.Column="1" Content="Beeper off" Tag="beeper.off"
                                IsEnabled="False" Click="InstantCommand_Click" Style="{StaticResource CommandButton}" />
                        <Button x:Name="BeeperMuteButton" Grid.Row="0" Grid.Column="2" Content="Mute beeper" Tag="beeper.mute"
                                IsEnabled="False" Click="InstantCommand_Click" Style="{StaticResource CommandButton}" />
                        <Button x:Name="BeeperEnableButton" Grid.Row="1" Grid.Column="0" Content="Enable beeper" Tag="beeper.enable"
                                IsEnabled="False" Click="InstantCommand_Click" Style="{StaticResource CommandButton}" />
                        <Button x:Name="BeeperDisableButton" Grid.Row="1" Grid.Column="1" Content="Disable beeper" Tag="beeper.disable"
                                IsEnabled="False" Click="InstantCommand_Click" Style="{StaticResource CommandButton}" />
                        <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal"
                                    HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,8,0">
                            <TextBlock Text="Status" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <Border x:Name="BeeperStatusBadge" Padding="10,5" CornerRadius="6"
                                    Background="#777777" VerticalAlignment="Center">
                                <TextBlock x:Name="BeeperStatusText" Text="Unknown" Foreground="White" FontWeight="SemiBold" />
                            </Border>
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="Command feedback" FontWeight="SemiBold" Margin="0,4,0,4" />
                    <TextBlock x:Name="BeeperCommandFeedbackText" Text="No beeper command sent in this session."
                               TextWrapping="Wrap" Margin="0,0,0,2" />
                </StackPanel>
            </Border>

            <Border Padding="14" Margin="0,0,0,12" CornerRadius="8"
                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                    Background="{DynamicResource CardBrush}">
                <StackPanel>
                    <TextBlock Text="Power controls" Style="{StaticResource SectionTitle}" />
                    <WrapPanel>
                        <Button x:Name="LoadOffButton" Content="Turn load off" Tag="load.off"
                                IsEnabled="False" Click="InstantCommand_Click" Style="{StaticResource CommandButton}"
                                ToolTip="Turn off the UPS load output. Connected equipment may lose power." />
                        <Button x:Name="LoadOffDelayButton" Content="Turn load off (delay)" Tag="load.off.delay"
                                IsEnabled="False" Click="InstantCommand_Click" Style="{StaticResource CommandButton}"
                                ToolTip="Schedule the UPS load output to turn off after its configured delay." />
                        <Button x:Name="ShutdownRebootButton" Content="Reboot UPS" Tag="shutdown.reboot"
                                IsEnabled="False" Click="InstantCommand_Click" Style="{StaticResource CommandButton}"
                                ToolTip="Reboot the UPS. Connected equipment may lose power." />
                        <Button x:Name="ShutdownStopButton" Content="Stop shutdown" Tag="shutdown.stop"
                                IsEnabled="False" Click="InstantCommand_Click" Style="{StaticResource CommandButton}"
                                ToolTip="Attempt to cancel a pending UPS shutdown." />
                    </WrapPanel>
                    <TextBlock Text="Command feedback" FontWeight="SemiBold" Margin="0,4,0,4" />
                    <TextBlock x:Name="PowerCommandFeedbackText" Text="No power command sent in this session."
                               TextWrapping="Wrap" Margin="0,0,0,2" />
                </StackPanel>
            </Border>

            <Grid Margin="0,0,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Padding="12" Margin="0,0,5,0" CornerRadius="8"
                        BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                        Background="{DynamicResource CardBrush}">
                    <StackPanel>
                        <TextBlock x:Name="CommandListHeading" Text="Supported Instant Commands"
                                   Style="{StaticResource SectionTitle}" TextWrapping="Wrap" />
                        <ListBox x:Name="CommandList" MinHeight="150" MaxHeight="180"
                                 Background="Transparent" BorderThickness="0" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Padding="12" Margin="5,0,0,0" CornerRadius="8"
                        BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                        Background="{DynamicResource CardBrush}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,8" LastChildFill="True">
                            <Button x:Name="ClearUnsupportedVariablesButton" DockPanel.Dock="Right"
                                    Content="Clear list" Padding="8,4" Margin="4,0,0,0"
                                    Click="ClearUnsupportedVariablesButton_Click" />
                            <TextBlock Text="Unsupported Variables" Style="{StaticResource SectionTitle}"
                                       Margin="0" TextWrapping="Wrap" VerticalAlignment="Center" />
                        </DockPanel>
                        <TextBlock Text="These variables are not supported by your UPS and are excluded from polling."
                                   TextWrapping="Wrap" Margin="0,0,0,8"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <ListBox x:Name="UnsupportedVariablesList" MinHeight="115" MaxHeight="180"
                                 Background="Transparent" BorderThickness="0" />
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Window>
